@using AiEstimator.Models
@{
    ViewData["Title"] = "Game Development Estimation";
    var estimationResult = ViewBag.EstimationResult as GameEstimationResult;
}

<div class="result-container">
    <div class="result-header">
        <h1>Game Development Estimation</h1>
        <p class="file-name">File: @ViewBag.FileName</p>
        <span class="badge">Unity Engine</span>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="error-message">@ViewBag.Error</div>
    }
    else if (estimationResult != null)
    {
        <div class="project-summary">
            <h3>Project Overview</h3>
            <p>@estimationResult.ProjectSummary</p>
        </div>

        <div class="totals-grid">
            <div class="total-card">
                <div class="total-icon">💻</div>
                <div class="total-label">Development</div>
                <div class="total-value">@estimationResult.TotalDevHours hrs</div>
                <div class="total-days">~@Math.Ceiling(estimationResult.TotalDevHours / 8.0) days</div>
            </div>
            <div class="total-card">
                <div class="total-icon">🎨</div>
                <div class="total-label">Art & Design</div>
                <div class="total-value">@estimationResult.TotalArtHours hrs</div>
                <div class="total-days">~@Math.Ceiling(estimationResult.TotalArtHours / 8.0) days</div>
            </div>
            <div class="total-card highlight">
                <div class="total-icon">⏱️</div>
                <div class="total-label">Total Project</div>
                <div class="total-value">@estimationResult.TotalHours hrs</div>
                <div class="total-days">~@Math.Ceiling(estimationResult.TotalHours / 8.0) days</div>
            </div>
        </div>

        <div class="features-section">
            <h3>Feature Breakdown</h3>
            <div class="table-responsive">
                <table class="features-table">
                    <thead>
                        <tr>
                            <th>Feature</th>
                            <th>Description</th>
                            <th>Complexity</th>
                            <th>Dev (hrs)</th>
                            <th>Art (hrs)</th>
                            <th>Total (hrs)</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var feature in estimationResult.Features)
                        {
                            var complexityClass = feature.Complexity.ToLower();
                            var totalFeatureHours = feature.DevEstimateHours + feature.ArtEstimateHours;
                            
                            <tr>
                                <td class="feature-name">@feature.Feature</td>
                                <td class="description">@feature.Description</td>
                                <td>
                                    <span class="complexity-badge @complexityClass">
                                        @feature.Complexity
                                    </span>
                                </td>
                                <td class="number">@feature.DevEstimateHours</td>
                                <td class="number">@feature.ArtEstimateHours</td>
                                <td class="number total">@totalFeatureHours</td>
                                <td class="notes">@feature.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (estimationResult.Billing != null && estimationResult.Team.Any())
        {
            <div class="billing-section">
                <h3>💰 Project Billing & Resource Allocation</h3>
                
                <div class="billing-totals">
                    <div class="billing-card">
                        <div class="billing-label">Development Cost</div>
                        <div class="billing-value">@($"${estimationResult.Billing.TotalDevCost:N2}")</div>
                    </div>
                    <div class="billing-card">
                        <div class="billing-label">Art & Design Cost</div>
                        <div class="billing-value">@($"${estimationResult.Billing.TotalArtCost:N2}")</div>
                    </div>
                    <div class="billing-card highlight">
                        <div class="billing-label">Total Project Cost</div>
                        <div class="billing-value">@($"${estimationResult.Billing.GrandTotal:N2}")</div>
                    </div>
                </div>

                <h4>Team Member Billing</h4>
                <div class="table-responsive">
                    <table class="billing-table">
                        <thead>
                            <tr>
                                <th>Team Member</th>
                                <th>Role</th>
                                <th>Level</th>
                                <th>Total Hours</th>
                                <th>Rate/Hour</th>
                                <th>Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var billing in estimationResult.Billing.TeamMemberBillings)
                            {
                                <tr>
                                    <td class="member-name">@billing.TeamMemberName</td>
                                    <td>
                                        <span class="role-badge @billing.Role.ToLower()">@billing.Role</span>
                                    </td>
                                    <td>
                                        <span class="level-badge @billing.Level.ToLower()">@billing.Level</span>
                                    </td>
                                    <td class="number">@billing.TotalHours hrs</td>
                                    <td class="number">@($"${billing.HourlyRate:N2}")</td>
                                    <td class="number cost">@($"${billing.TotalCost:N2}")</td>
                                </tr>
                            }
                            <tr class="total-row">
                                <td colspan="5" class="total-label">Grand Total</td>
                                <td class="number grand-total">@($"${estimationResult.Billing.GrandTotal:N2}")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    
    <div class="actions">
        <a asp-controller="Home" asp-action="ExportPdf" class="export-button">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Export to PDF
        </a>
        <a asp-controller="Home" asp-action="Index" class="back-button">Upload Another PDF</a>
    </div>
</div>

<style>
    .result-container {
        width: 100%;
        max-width: 2000px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .result-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #667eea;
    }

    .result-header h1 {
        color: #333;
        font-size: 32px;
        margin-bottom: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .file-name {
        color: #666;
        font-size: 16px;
        font-weight: 500;
        margin-bottom: 10px;
        display: block;
    }

    .badge {
        display: inline-block;
        background: #667eea;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .project-summary {
        background: linear-gradient(135deg, #f8f9ff 0%, #e8ebff 100%);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        border: 2px solid #e0e5ff;
    }

    .project-summary h3 {
        color: #667eea;
        margin-bottom: 10px;
        font-size: 20px;
    }

    .project-summary p {
        color: #333;
        line-height: 1.6;
        margin: 0;
        font-size: 16px;
    }

    .totals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .total-card {
        background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
        border: 2px solid #e0e5ff;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .total-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
    }

    .total-card.highlight {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #667eea;
    }

    .total-card.highlight .total-label,
    .total-card.highlight .total-value,
    .total-card.highlight .total-days {
        color: white;
    }

    .total-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .total-label {
        color: #666;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .total-value {
        color: #667eea;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .total-days {
        color: #999;
        font-size: 14px;
    }

    .features-section {
        margin-bottom: 30px;
    }

    .features-section h3,
    .billing-section h3 {
        color: #333;
        font-size: 24px;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e0e5ff;
    }

    .billing-section {
        margin-bottom: 30px;
        padding-top: 20px;
        border-top: 3px solid #667eea;
    }

    .billing-section h4 {
        color: #667eea;
        font-size: 18px;
        margin-top: 25px;
        margin-bottom: 15px;
    }

    .billing-totals {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .billing-card {
        background: white;
        border: 2px solid #e0e5ff;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
    }

    .billing-card.highlight {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-color: #28a745;
    }

    .billing-card.highlight .billing-label,
    .billing-card.highlight .billing-value {
        color: white;
    }

    .billing-label {
        font-size: 13px;
        color: #666;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .billing-value {
        font-size: 28px;
        font-weight: 700;
        color: #28a745;
    }

    .billing-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .billing-table thead {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .billing-table th {
        padding: 12px 10px;
        text-align: left;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
    }

    .billing-table td {
        padding: 12px 10px;
        border-bottom: 1px solid #e0e5ff;
    }

    .billing-table tbody tr:hover {
        background: #f8f9ff;
    }

    .billing-table .member-name {
        font-weight: 600;
        color: #333;
    }

    .billing-table .cost {
        color: #28a745;
        font-weight: 700;
        font-size: 15px;
    }

    .billing-table .total-row {
        background: #f8f9ff;
        font-weight: 700;
    }

    .billing-table .total-row:hover {
        background: #f0f2ff !important;
    }

    .billing-table .total-label {
        text-align: right;
        font-size: 15px;
        color: #333;
    }

    .billing-table .grand-total {
        color: #28a745;
        font-size: 18px;
        font-weight: 700;
    }

    .role-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .role-badge.developer {
        background: #007bff;
        color: white;
    }

    .role-badge.artist {
        background: #e83e8c;
        color: white;
    }

    .level-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .level-badge.senior {
        background: #28a745;
        color: white;
    }

    .level-badge.junior {
        background: #ffc107;
        color: #333;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .features-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .features-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .features-table th {
        padding: 15px 10px;
        text-align: left;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }

    .features-table td {
        padding: 15px 10px;
        border-bottom: 1px solid #e0e5ff;
        vertical-align: top;
    }

    .features-table tbody tr:hover {
        background: #f8f9ff;
    }

    .features-table .feature-name {
        font-weight: 600;
        color: #667eea;
        min-width: 150px;
    }

    .features-table .description {
        color: #555;
        line-height: 1.5;
        max-width: 300px;
    }

    .features-table .number {
        text-align: center;
        font-weight: 600;
        color: #333;
        min-width: 80px;
    }

    .features-table .number.total {
        color: #667eea;
        font-size: 16px;
    }

    .features-table .notes {
        color: #666;
        font-size: 13px;
        font-style: italic;
        max-width: 250px;
    }

    .complexity-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .complexity-badge.low {
        background: #d4edda;
        color: #155724;
    }

    .complexity-badge.medium {
        background: #fff3cd;
        color: #856404;
    }

    .complexity-badge.high {
        background: #f8d7da;
        color: #721c24;
    }

    .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 1px solid #f5c6cb;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .export-button,
    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 16px 40px;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .export-button {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.4);
    }

    .export-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(40, 167, 69, 0.6);
    }

    .export-button svg {
        flex-shrink: 0;
    }

    .back-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .back-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    @@media (max-width: 768px) {
        .result-container {
            padding: 20px;
        }

        .totals-grid {
            grid-template-columns: 1fr;
        }

        .features-table {
            font-size: 12px;
        }

        .features-table th,
        .features-table td {
            padding: 10px 5px;
        }
    }
</style>
