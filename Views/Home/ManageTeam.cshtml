@model AiEstimator.Models.TeamManagementViewModel
@{
    ViewData["Title"] = "Manage Team";
}

<div class="test-container">
    <h1>Manage Team</h1>
    <p class="subtitle">Add developers and artists with their rates for automatic allocation</p>
    
    <div class="team-form-section">
        <h3>Add Team Member</h3>
        <form id="addTeamMemberForm">
            <div class="form-row">
                <div class="form-group">
                    <label for="memberName">Name</label>
                    <input type="text" id="memberName" name="memberName" placeholder="John Doe" required />
                </div>
                
                <div class="form-group">
                    <label for="memberRole">Role</label>
                    <select id="memberRole" name="memberRole" required>
                        <option value="">Select Role</option>
                        <option value="Developer">Developer</option>
                        <option value="Artist">Artist</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="memberLevel">Level</label>
                    <select id="memberLevel" name="memberLevel" required>
                        <option value="">Select Level</option>
                        <option value="Senior">Senior</option>
                        <option value="Junior">Junior</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="memberRate">Hourly Rate ($)</label>
                    <input type="number" id="memberRate" name="memberRate" placeholder="30" min="1" step="0.01" required />
                </div>
            </div>
            
            <button type="submit" class="send-button">Add Team Member</button>
        </form>
    </div>
    
    <div class="team-list-section">
        <h3>Current Team (<span id="teamCount">@Model.TeamMembers.Count</span>)</h3>
        <div id="teamList" class="team-list">
            @if (Model.TeamMembers.Any())
            {
                @foreach (var member in Model.TeamMembers)
                {
                    <div class="team-member-card" data-id="@member.Id">
                        <div class="member-info">
                            <div class="member-name">@member.Name</div>
                            <div class="member-details">
                                <span class="badge @member.Role.ToLower()">@member.Role</span>
                                <span class="badge @member.Level.ToLower()">@member.Level</span>
                                <span class="member-rate">$@member.HourlyRate/hr</span>
                            </div>
                        </div>
                        <button class="delete-btn" onclick="deleteMember('@member.Id')">×</button>
                    </div>
                }
            }
            else
            {
                <div class="empty-state" id="emptyState">
                    <p>No team members added yet. Add your first team member above!</p>
                </div>
            }
        </div>
    </div>
    
    <div id="message" class="message"></div>
    
    <div style="margin-top: 20px; text-align: center;">
        <a href="@Url.Action("Index", "Home")" class="test-button">Back to Upload</a>
    </div>
</div>

@section Scripts {
    <script>
        const addForm = document.getElementById('addTeamMemberForm');
        const teamList = document.getElementById('teamList');
        const teamCount = document.getElementById('teamCount');
        const messageDiv = document.getElementById('message');
        const emptyState = document.getElementById('emptyState');

        addForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(addForm);
            const teamMember = {
                name: formData.get('memberName'),
                role: formData.get('memberRole'),
                level: formData.get('memberLevel'),
                hourlyRate: parseFloat(formData.get('memberRate'))
            };
            
            try {
                const response = await fetch('/Home/AddTeamMember', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(teamMember)
                });
                
                if (response.ok) {
                    const result = await response.json();
                    addTeamMemberToList(result.member);
                    addForm.reset();
                    showMessage('Team member added successfully!', 'success');
                    updateTeamCount(1);
                } else {
                    const error = await response.text();
                    showMessage(error || 'Failed to add team member', 'error');
                }
            } catch (error) {
                showMessage('An error occurred: ' + error.message, 'error');
            }
        });

        function addTeamMemberToList(member) {
            if (emptyState) {
                emptyState.remove();
            }
            
            const card = document.createElement('div');
            card.className = 'team-member-card';
            card.dataset.id = member.id;
            card.innerHTML = `
                <div class="member-info">
                    <div class="member-name">${member.name}</div>
                    <div class="member-details">
                        <span class="badge ${member.role.toLowerCase()}">${member.role}</span>
                        <span class="badge ${member.level.toLowerCase()}">${member.level}</span>
                        <span class="member-rate">$${member.hourlyRate}/hr</span>
                    </div>
                </div>
                <button class="delete-btn" onclick="deleteMember('${member.id}')">×</button>
            `;
            
            teamList.appendChild(card);
        }

        async function deleteMember(id) {
            if (!confirm('Are you sure you want to remove this team member?')) {
                return;
            }
            
            try {
                const response = await fetch(`/Home/DeleteTeamMember/${id}`, {
                    method: 'DELETE'
                });
                
                if (response.ok) {
                    const card = document.querySelector(`[data-id="${id}"]`);
                    card.remove();
                    showMessage('Team member removed', 'success');
                    updateTeamCount(-1);
                    
                    if (teamList.children.length === 0) {
                        teamList.innerHTML = '<div class="empty-state"><p>No team members added yet. Add your first team member above!</p></div>';
                    }
                } else {
                    showMessage('Failed to remove team member', 'error');
                }
            } catch (error) {
                showMessage('An error occurred: ' + error.message, 'error');
            }
        }

        function updateTeamCount(delta) {
            const currentCount = parseInt(teamCount.textContent);
            teamCount.textContent = currentCount + delta;
        }

        function showMessage(text, type) {
            messageDiv.textContent = text;
            messageDiv.className = `message ${type}`;
            setTimeout(() => {
                messageDiv.textContent = '';
                messageDiv.className = 'message';
            }, 3000);
        }
    </script>
    
    <style>
        .subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-top: -15px;
            margin-bottom: 30px;
        }

        .team-form-section {
            background: #f8f9ff;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .team-form-section h3 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 18px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-group input,
        .form-group select {
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #667eea;
        }

        .team-list-section {
            margin-bottom: 30px;
        }

        .team-list-section h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .team-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
        }

        .team-member-card {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .team-member-card:hover {
            border-color: #667eea;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
        }

        .member-info {
            flex: 1;
        }

        .member-name {
            font-weight: 600;
            font-size: 16px;
            color: #333;
            margin-bottom: 8px;
        }

        .member-details {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .badge.developer {
            background: #007bff;
            color: white;
        }

        .badge.artist {
            background: #e83e8c;
            color: white;
        }

        .badge.senior {
            background: #28a745;
            color: white;
        }

        .badge.junior {
            background: #ffc107;
            color: #333;
        }

        .member-rate {
            font-weight: 600;
            color: #667eea;
            font-size: 14px;
        }

        .delete-btn {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            line-height: 1;
            padding: 0;
        }

        .delete-btn:hover {
            background: #c82333;
            transform: scale(1.1);
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px;
            color: #999;
            font-style: italic;
        }
    </style>
}
