@{
    ViewData["Title"] = "PDF Upload";
}

<div class="upload-container">
    <h1>AI Estimator</h1>
    
    <form id="uploadForm" asp-controller="Home" asp-action="UploadPdf" method="post" enctype="multipart/form-data">
        <div id="dropZone" class="drop-zone">
            <div class="drop-zone-content">
                <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <p class="drop-zone-text">Drag & Drop your PDF file here</p>
                <p class="drop-zone-subtext">or click to browse</p>
                <span id="fileName" class="file-name"></span>
            </div>
            <input type="file" id="fileInput" name="pdfFile" accept=".pdf" style="display: none;" />
        </div>
        
        <button type="submit" id="sendButton" class="send-button" disabled>Send</button>
    </form>
    
    <div id="message" class="message"></div>
</div>

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileName = document.getElementById('fileName');
        const sendButton = document.getElementById('sendButton');
        const uploadForm = document.getElementById('uploadForm');
        const messageDiv = document.getElementById('message');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('drag-over');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('drag-over');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (file.type === 'application/pdf') {
                    fileInput.files = files;
                    handleFileSelect(file);
                } else {
                    showMessage('Please select a PDF file', 'error');
                }
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFileSelect(e.target.files[0]);
            }
        });

        function handleFileSelect(file) {
            fileName.textContent = file.name;
            fileName.style.display = 'block';
            sendButton.disabled = false;
            messageDiv.textContent = '';
        }

        uploadForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(uploadForm);
            sendButton.disabled = true;
            sendButton.textContent = 'Processing...';
            
            try {
                const response = await fetch('/Home/UploadPdf', {
                    method: 'POST',
                    body: formData
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        showMessage('Processing complete', 'success');
                    }
                } else {
                    const error = await response.text();
                    showMessage(error || 'Upload failed', 'error');
                    sendButton.disabled = false;
                    sendButton.textContent = 'Send';
                }
            } catch (error) {
                showMessage('An error occurred: ' + error.message, 'error');
                sendButton.disabled = false;
                sendButton.textContent = 'Send';
            }
        });

        function showMessage(text, type) {
            messageDiv.textContent = text;
            messageDiv.className = `message ${type}`;
        }
    </script>
}
